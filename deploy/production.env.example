# Copy to deploy/production.env (never commit it) and fill in every value.
# Generate secrets with: openssl rand -hex 32

# The image tag; autoupdate.sh moves it forward. Keep the line bare.
SENTINEL_VERSION=0.10.2
AGENT_VERSION=0.10.0             # agent/VERSION; new ones start as a canary
AGENT_CANARY_PERCENT=10          # share of servers offered a new agent first
REGISTRY=ghcr.io/alzywelzy

# Public hostnames. The web app and the API share APP_HOST (the API is under
# /api), so the sign-in cookie stays first-party. Changing hostnames later is
# a config change: agents fetch their ingest URL from Sentinel and follow it.
APP_HOST=sentinel.rajpoot.app
INGEST_HOST=sentinel-ingest.rajpoot.app
DOWNLOAD_HOST=sentinel-get.rajpoot.app
# Cloudflare Tunnel (the way in; DEPLOYMENT.md §2): the tunnel's token.
TUNNEL_TOKEN=
# Without a tunnel: CADDYFILE=Caddyfile and publish 80/443 on caddy.
CADDYFILE=Caddyfile.tunnel
# Status pages on customers' domains (Cloudflare for SaaS): a token with
# "SSL and Certificates: Edit" on the zone, the zone id, and the hostname
# customers point their CNAME at (the zone's fallback origin).
CF_API_TOKEN=
CF_ZONE_ID=
STATUS_DOMAIN_TARGET=sentinel-customers.rajpoot.app
ACME_EMAIL=ops@rajpoot.app

# Accounts
AUTH_SECRET=                     # signs sessions; rotate via AUTH_SECRET_PREVIOUS
AUTH_SECRET_PREVIOUS=
CREDENTIALS_KEY=                 # encrypts network device credentials (SNMP); keep it: changing it loses them
SUPERADMIN_EMAILS=               # comma-separated; verified accounts with these emails
SIGNUP_ENABLED=true
TURNSTILE_SITE_KEY=              # Cloudflare Turnstile, on sign-up and password reset
TURNSTILE_SECRET_KEY=
CAPTCHA_DISABLED=false           # true only for a private install without public sign-up

# Secrets
POSTGRES_PASSWORD=
SENTINEL_APP_PASSWORD=
SENTINEL_SERVICE_PASSWORD=
WEBHOOK_SIGNING_SECRET=          # customers verify X-Sentinel-Signature with it
ACK_SIGNING_SECRET=              # signs one-click acknowledge links in alerts

# Email: alerts, verification codes, sign-up, reset and invitations. Any SMTP
# server or a provider's SMTP relay (SES, Postmark, Resend). The sending
# domain needs SPF, DKIM and DMARC records (see DEPLOYMENT.md).
# Resend: smtp.resend.com, 465, user "resend", the API key as password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM="Sentinel <alerts@sentinel.rajpoot.app>"
SMTP_TLS=tls                     # starttls | tls | none

# Web Push: generate once with `docker run --rm <registry>/sentinel-alerter:<v> vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@rajpoot.app

# Contact types customers may add. SMS and voice need a Twilio account below.
ENABLED_CHANNEL_TYPES=email,push,webhook,slack,teams,discord,telegram
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Organisations (ids) whose agents may serve as public uptime probes.
PROBE_ACCOUNT_IDS=

METRICS_RETENTION=90d
LONG_METRICS_RETENTION=2y
LOG_RETENTION=14d
# IPDR evidence store (ClickHouse): openssl rand -hex 32
CLICKHOUSE_PASSWORD=
BACKUP_KEEP_DAYS=7

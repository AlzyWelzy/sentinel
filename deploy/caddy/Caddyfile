{
	email {$ACME_EMAIL}
	# Certificates for status pages on customers' own domains, only for
	# domains a published page has verified (TXT record).
	on_demand_tls {
		ask http://api:8000/public/domain-check
	}
}

# The web app, with the API under /api on the same origin: the sign-in
# cookie is first-party and the browser needs no CORS.
{$APP_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle_path /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Agent registration and metric pushes.
{$INGEST_HOST} {
	request_body {
		max_size 34MB
	}
	reverse_proxy ingest:8080
}

# install.sh, install.ps1 and agent binaries: the API image carries the
# binaries of its agent version and the previous ones (or point this host at
# a CDN with the release's files instead).
{$DOWNLOAD_HOST} {
	@download path /install.sh /install.ps1 /agent/*
	handle @download {
		reverse_proxy api:8000
	}
	respond 404
}

# Status pages on customers' own domains (a CNAME to {$APP_HOST}): any
# other name gets its page from the API, chosen by the Host header.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	rewrite * /public/host{uri}
	reverse_proxy api:8000 {
		header_up X-Status-Host {host}
	}
}

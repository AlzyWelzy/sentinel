{
  "name": "sentinel-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:schema": "cd ../api && uv run python -c \"import json; from app.main import app; print(json.dumps(app.openapi(), indent=1))\" > ../web/openapi.json",
    "api:types": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "api": "npm run api:schema && npm run api:types"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

# Copy to deploy/production.env (never commit it) and fill in every value.
# Generate secrets with: openssl rand -hex 32

PULSEGRID_VERSION=0.9.0          # image tag
AGENT_VERSION=0.9.0              # agent/VERSION; new ones start as a canary
AGENT_CANARY_PERCENT=10          # share of servers offered a new agent first
REGISTRY=ghcr.io/alzywelzy

# Public hostnames. The web app and the API share APP_HOST (the API is under
# /api), so the sign-in cookie stays first-party. Changing hostnames later is
# a config change: agents fetch their ingest URL from Pulsegrid and follow it.
APP_HOST=pulsegrid.rajpoot.ap
INGEST_HOST=ingest.pulsegrid.rajpoot.ap
DOWNLOAD_HOST=get.pulsegrid.rajpoot.ap
ACME_EMAIL=ops@rajpoot.ap

# Accounts
AUTH_SECRET=                     # signs sessions; rotate via AUTH_SECRET_PREVIOUS
AUTH_SECRET_PREVIOUS=
SUPERADMIN_EMAILS=               # comma-separated; verified accounts with these emails
SIGNUP_ENABLED=true
TURNSTILE_SITE_KEY=              # Cloudflare Turnstile, on sign-up and password reset
TURNSTILE_SECRET_KEY=
CAPTCHA_DISABLED=false           # true only for a private install without public sign-up

# Secrets
POSTGRES_PASSWORD=
PULSEGRID_APP_PASSWORD=
PULSEGRID_SERVICE_PASSWORD=
WEBHOOK_SIGNING_SECRET=          # customers verify X-Pulsegrid-Signature with it
ACK_SIGNING_SECRET=              # signs one-click acknowledge links in alerts

# Email: alerts, verification codes, sign-up, reset and invitations. Any SMTP
# server or a provider's SMTP relay (SES, Postmark, Resend). The sending
# domain needs SPF, DKIM and DMARC records (see DEPLOYMENT.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Pulsegrid <alerts@pulsegrid.rajpoot.ap>"
SMTP_TLS=starttls                # starttls | tls | none

# Web Push: generate once with `docker run --rm <registry>/pulsegrid-beyond-alerter:<v> vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@rajpoot.ap

# Contact types customers may add. SMS and voice need a Twilio account below.
ENABLED_CHANNEL_TYPES=email,push,webhook,slack,teams,discord,telegram
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Organisations (ids) whose agents may serve as public uptime probes.
PROBE_ACCOUNT_IDS=

METRICS_RETENTION=90d
LONG_METRICS_RETENTION=2y
LOG_RETENTION=14d
BACKUP_KEEP_DAYS=7

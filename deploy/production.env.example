# Copy to deploy/production.env (never commit it) and fill in every value.
# Generate secrets with: openssl rand -hex 32

PULSEGRID_VERSION=0.1.0          # image tag
AGENT_VERSION=0.1.0              # agents self-update to this
REGISTRY=ghcr.io/example-org

# Public hostnames. Changing them later is a config change: agents fetch
# their ingest URL from Pulsegrid and follow it.
API_HOST=pulsegrid.Example.com
INGEST_HOST=ingest.pulsegrid.Example.com
DOWNLOAD_HOST=get.pulsegrid.Example.com
ACME_EMAIL=ops@Example.com

# The console: its origin (for CORS), its JWKS and token issuer/audience
# (same values billing-ms uses), and where incident links should point.
CORS_ORIGINS=https://console.Example.com
JWKS_URI=https://console.Example.com/api/.well-known/jwks.json/
JWT_TOKEN_ISSUER=
JWT_TOKEN_AUDIENCE=
PUBLIC_DASHBOARD_URL=https://console.Example.com/monitoring?tab=servers

# Secrets
POSTGRES_PASSWORD=
PULSEGRID_APP_PASSWORD=
PULSEGRID_SERVICE_PASSWORD=
INTERNAL_API_KEY=                # the console backend sends this as X-Internal-Api-Key
WEBHOOK_SIGNING_SECRET=          # customers verify X-Pulsegrid-Signature with it
ACK_SIGNING_SECRET=              # signs one-click acknowledge links in alerts

# Email for alerts and verification codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Pulsegrid <alerts@Example.com>"
SMTP_TLS=starttls                # starttls | tls | none

# SMS (optional; SMS contacts fail clearly until this is set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

METRICS_RETENTION=90d

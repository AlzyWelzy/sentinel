# Pulsegrid behind the console (deploy/stack.console.yml). Copy to
# deploy/<env>.env on the swarm manager (never commit it). Generate secrets
# with: openssl rand -hex 32

PULSEGRID_VERSION=0.1.0
REGISTRY=ghcr.io/example-org
PULSEGRID_NETWORK=pulsegrid-dev        # shared with the console stack
# Swarm node(s) to run on; data volumes live there.
PULSEGRID_PLACEMENT="node.role == manager"

# The console this Pulsegrid serves (its domain also serves Pulsegrid).
CONSOLE_HOST=dev.Example.com
# Same issuer/audience as billing-ms in that environment.
JWT_TOKEN_ISSUER=dev.Example.com
JWT_TOKEN_AUDIENCE=dev.Example.com

# Secrets
POSTGRES_PASSWORD=
PULSEGRID_APP_PASSWORD=
PULSEGRID_SERVICE_PASSWORD=
INTERNAL_API_KEY=            # console -> Pulsegrid /internal (console: PULSEGRID_INTERNAL_API_KEY)
CONSOLE_INTERNAL_API_KEY=    # Pulsegrid -> console email endpoint (console: PULSEGRID_CALLBACK_API_KEY)
WEBHOOK_SIGNING_SECRET=

# Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
METRICS_RETENTION=90d
